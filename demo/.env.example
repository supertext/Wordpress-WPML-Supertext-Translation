# Variables of the demo (demo/Dockerfile). On Railway they live in the service's variables;
# never commit real values. See docs/DEVELOPER.md → Demo site.
DATABASE_URL=mysql://root:secret@localhost:3306/wordpress_wpml_demo
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=editor@example.com
DEMO_EDITOR_PASSWORD=
# Download URL of the WPML Multilingual CMS zip (WPML is commercial). From the private repository
# supertext/integrations-demo-assets: https://api.github.com/repos/supertext/integrations-demo-assets/contents/wpml/<file>.zip
WPML_ZIP_URL=
# Bearer token for a URL that needs one (e.g. a read-only GitHub token for that API URL). On Railway the zip
# comes from the demo-assets service instead: http://demo-assets.railway.internal:8080/wpml/sitepress-multilingual-cms.5.3.0.zip
WPML_ZIP_TOKEN=
# WPML's site key (wpml.org → Account → Sites).
WPML_SITE_KEY=
# AI translation. No Supertext account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate your API key at https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API; requires the Admin role).
SUPERTEXT_API_KEY=
# Professional (human) translation orders: account email and Order API Key (Supertext account settings).
SUPERTEXT_ACCOUNT_EMAIL=
SUPERTEXT_ORDER_API_KEY=
SUPERTEXT_ENVIRONMENT=live
DEMO_SITE_URL=http://localhost:8080
