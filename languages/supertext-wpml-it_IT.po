msgstr "Solo per il debug: rimuove il blocco locale così l'articolo può essere ordinato di nuovo. Non annulla l'ordine Supertext."

msgid "Supertext"
msgstr "Supertext"

msgid "Settings"
msgstr "Impostazioni"

msgid "Debug"
msgstr "Debug"

msgid "Version %s"
msgstr "Versione %s"

msgid "Everything is connected and running."
msgstr "Tutto è collegato e funzionante."

msgid "Not everything is set up yet: see the red rows below."
msgstr "Non è ancora tutto configurato: vedi le righe in rosso qui sotto."

