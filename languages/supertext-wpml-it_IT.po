msgstr "« %1$s »: la lingua di origine e quella di destinazione sono identiche (%2$s)."

msgid "Invalid post, or missing source/target language."
msgstr "Articolo non valido oppure lingua di origine/destinazione mancante."

msgid "An order already exists for \"%1$s\" (%2$s)."
msgstr "Esiste già un ordine per « %1$s » (%2$s)."

msgid "Supertext human-translation credentials are not configured."
msgstr "Le credenziali Supertext per la traduzione umana non sono configurate."

msgid "Select a translation type, a target language, and at least one post."
msgstr "Selezioni un tipo di traduzione, una lingua di destinazione e almeno un articolo."

msgid "Nothing to quote."
msgstr "Nessun contenuto per cui calcolare un prezzo."

msgid "Please select a target language before applying a Supertext translation action."
msgstr "Selezioni una lingua di destinazione prima di applicare un'azione di traduzione Supertext."

msgid "Please select a translation type before applying Supertext Human Translation."
msgstr "Selezioni un tipo di traduzione prima di applicare Traduzione umana Supertext."

msgid "Please select a delivery option before applying Supertext Human Translation."
msgstr "Selezioni un'opzione di consegna prima di applicare Traduzione umana Supertext."

msgid "Supertext human-translation credentials are not configured. Add your account email and Order API Key on the Supertext settings page."
msgstr "Le credenziali Supertext per la traduzione umana non sono configurate. Inserisca l'indirizzo e-mail del suo account e la chiave API per gli ordini nella pagina delle impostazioni Supertext."

